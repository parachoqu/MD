# Banco Neon separado por ambiente. Nunca reutilize Production em Preview.
# Pooled: usada somente pelo runtime HTTP e pelas Functions.
DATABASE_URL=postgresql://md_example:replace-me@ep-example-pooler.sa-east-1.aws.neon.tech/md_development?sslmode=require
# Direta: obrigatoria em migrate, seed, create-admin, export e import --apply.
# Nao existe fallback para DATABASE_URL; import sem --apply funciona offline.
DATABASE_URL_UNPOOLED=postgresql://md_example:replace-me@ep-example.sa-east-1.aws.neon.tech/md_development?sslmode=require

# Vercel Blob. Use um store separado quando o isolamento exigir.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example_replace_me

# Origem exata do ambiente, sem barra final.
APP_ORIGIN=http://localhost:3000

# Gere valores independentes, aleatorios e longos para cada ambiente.
SESSION_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes
IP_HASH_SECRET=replace-with-at-least-32-random-bytes

# Opcional ate a estrategia de criptografia de PII ser aprovada.
PII_ENCRYPTION_KEY=
