{
  "name": "md-temporary-vercel-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vercel dev",
    "check": "node scripts/check-source.mjs",
    "test": "node --test --test-reporter=spec",
    "test:unit": "node --test --test-reporter=spec test/unit",
    "test:db": "node --test --test-reporter=spec test/database",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "db:create-admin": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "db:export": "node --env-file-if-exists=.env.local scripts/export-data.mjs",
    "db:import-admin-export": "node --env-file-if-exists=.env.local scripts/import-admin-export.mjs",
    "build:vendor": "node scripts/build-vendor.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "2.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.28.2"
  }
}
